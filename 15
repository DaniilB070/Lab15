#define _CRT_SECURE_NO_WARNINGS   // чтобы Visual Studio не ругался на scanf

#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <locale.h>

#define NAME_SIZE 50
#define GREETING_SIZE 100

void clear_input_buffer(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

// ========== ЗАДАНИЕ 1 ==========

void task1_basic(void) {
    char name[NAME_SIZE];
    char greeting[GREETING_SIZE];

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    strcpy(greeting, "Привет, ");
    strcat(greeting, name);
    strcat(greeting, "!");

    puts(greeting);
}

void task1_uppercase(void) {
    char name[NAME_SIZE];
    char greeting[GREETING_SIZE];
    int i;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    for (i = 0; name[i] != '\0'; i++) {
        name[i] = (char)toupper((unsigned char)name[i]);
    }

    strcpy(greeting, "Привет, ");
    strcat(greeting, name);
    strcat(greeting, "!");

    puts(greeting);
}

void task1_pad_exclamation(void) {
    char name[NAME_SIZE];
    char greeting[GREETING_SIZE];
    size_t len;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    strcpy(greeting, "Привет, ");
    strcat(greeting, name);

    len = strlen(greeting);
    while (len < 40) {
        strcat(greeting, "!");
        len++;
    }

    puts(greeting);
    printf("(Длина строки: %zu символов)\n", strlen(greeting));
}

// ========== ЗАДАНИЕ 2 (все 12 модификаций) ==========

void task2_mod1(void) { // удваивается последняя буква
    char name[NAME_SIZE];
    char result[GREETING_SIZE];
    size_t len;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    len = strlen(name);
    strcpy(result, name);
    if (len > 0) {
        result[len] = name[len - 1];
        result[len + 1] = '\0';
    }

    printf("Привет, %s!\n", result);
}

void task2_mod2(void) { // первая строчная, остальные заглавные
    char name[NAME_SIZE];
    size_t i;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    if (name[0] != '\0') {
        name[0] = (char)tolower((unsigned char)name[0]);
        for (i = 1; name[i] != '\0'; i++) {
            name[i] = (char)toupper((unsigned char)name[i]);
        }
    }

    printf("Привет, %s!\n", name);
}

void task2_mod3(void) { // две первые буквы меняются местами
    char name[NAME_SIZE];
    char tmp;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    if (strlen(name) >= 2) {
        tmp = name[0];
        name[0] = name[1];
        name[1] = tmp;
    }

    printf("Привет, %s!\n", name);
}

void task2_mod4(void) { // перед последней буквой вставляется _
    char name[NAME_SIZE];
    char result[GREETING_SIZE];
    size_t len;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    len = strlen(name);
    if (len > 0) {
        strncpy(result, name, len - 1);
        result[len - 1] = '\0';
        strcat(result, "_");
        result[len] = name[len - 1];
        result[len + 1] = '\0';
    } else {
        strcpy(result, name);
    }

    printf("Привет, %s!\n", result);
}

void task2_mod5(void) { // имя наоборот
    char name[NAME_SIZE];
    char result[NAME_SIZE];
    size_t len, i;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    len = strlen(name);
    for (i = 0; i < len; i++) {
        result[i] = name[len - 1 - i];
    }
    result[len] = '\0';

    printf("Привет, %s!\n", result);
}

void task2_mod6(void) { // исчезает вторая буква
    char name[NAME_SIZE];
    char result[NAME_SIZE];
    size_t i, j = 0;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    for (i = 0; name[i] != '\0'; i++) {
        if (i != 1) {
            result[j++] = name[i];
        }
    }
    result[j] = '\0';

    printf("Привет, %s!\n", result);
}

void task2_mod7(void) { // половина букв строчные, остальные заглавные
    char name[NAME_SIZE];
    size_t len, i, half;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    len = strlen(name);
    half = len / 2;

    for (i = 0; i < len; i++) {
        if (i < half)
            name[i] = (char)tolower((unsigned char)name[i]);
        else
            name[i] = (char)toupper((unsigned char)name[i]);
    }

    printf("Привет, %s!\n", name);
}

void task2_mod8(void) { // после первых трёх букв ...
    char name[NAME_SIZE];
    char result[NAME_SIZE];

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    if (strlen(name) > 3) {
        strncpy(result, name, 3);
        result[3] = '\0';
        strcat(result, "...");
    } else {
        strcpy(result, name);
    }

    printf("Привет, %s!\n", result);
}

void task2_mod9(void) { // после каждой буквы пробел
    char name[NAME_SIZE];
    char result[GREETING_SIZE];
    size_t i, j = 0;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    for (i = 0; name[i] != '\0'; i++) {
        result[j++] = name[i];
        result[j++] = ' ';
    }
    if (j > 0) result[j - 1] = '\0';
    else result[0] = '\0';

    printf("Привет, %s!\n", result);
}

void task2_mod10(void) { // 'a'/'A' → @
    char name[NAME_SIZE];
    size_t i;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    for (i = 0; name[i] != '\0'; i++) {
        if (name[i] == 'a' || name[i] == 'A')
            name[i] = '@';
    }

    printf("Привет, %s!\n", name);
}

void task2_mod11(void) { // предпоследняя буква → -
    char name[NAME_SIZE];
    size_t len;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    len = strlen(name);
    if (len >= 2)
        name[len - 2] = '-';

    printf("Привет, %s!\n", name);
}

void task2_mod12(void) { // утраивается заглавная (или первая) буква
    char name[NAME_SIZE];
    char result[GREETING_SIZE];
    size_t i, j = 0;
    int found = 0;

    puts("Пожалуйста, введите ваше имя: ");
    scanf("%49s", name);

    for (i = 0; name[i] != '\0'; i++) {
        if (!found && isupper((unsigned char)name[i])) {
            result[j++] = name[i];
            result[j++] = name[i];
            result[j++] = name[i];
            found = 1;
        } else {
            result[j++] = name[i];
        }
    }
    result[j] = '\0';

    if (!found && name[0] != '\0') {
        result[0] = name[0];
        result[1] = name[0];
        result[2] = name[0];
        strcpy(result + 3, name + 1);
    }

    printf("Привет, %s!\n", result);
}

